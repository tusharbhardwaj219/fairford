# Cloud Run environment variables template.
# Copy to `.env.yaml` (which is gitignored), fill in REAL values from backend/.env,
# then deploy with:  gcloud run deploy fairford-pharma --source . --env-vars-file .env.yaml ...
#
# Values must be strings (keep the quotes). Do NOT commit the filled-in .env.yaml.

NODE_ENV: "production"
FRONTEND_URL: "https://fairfordpharma.com"
JWT_EXPIRES_IN: "7d"

MONGO_URI: "REPLACE_with_your_atlas_uri"
JWT_SECRET: "REPLACE"
JWT_REFRESH_SECRET: "REPLACE"

CLOUDINARY_CLOUD_NAME: "REPLACE"
CLOUDINARY_API_KEY: "REPLACE"
CLOUDINARY_API_SECRET: "REPLACE"

EMAIL_USER: "REPLACE"
EMAIL_PASS: "REPLACE_with_the_NEW_rotated_gmail_app_password"
ADMIN_EMAIL: "REPLACE"
