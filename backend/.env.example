# ─── Fair Ford Pharma — backend environment template ───────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`
# (it is gitignored). Rotate any secret that has ever been committed or shared.

# MongoDB connection string (e.g. MongoDB Atlas SRV/standard URI)
MONGO_URI=mongodb://<user>:<password>@<host>/<db>?ssl=true&authSource=admin

PORT=5000
NODE_ENV=development

# JWT signing secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret
# Optional: access-token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Public origin of the deployed frontend (used for CORS, reset links, sitemap)
FRONTEND_URL=http://localhost:5000

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer via Gmail — use a Gmail App Password, not your login password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
ADMIN_EMAIL=admin@fairfordpharma.com

# Razorpay payment gateway — https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_, live keys with rzp_live_.
# KEY_ID is public (it is sent to the browser). KEY_SECRET is server-only:
# never commit it, never expose it through an API, never put it in frontend code.
# Leave both blank to run cash-on-delivery only — online payment then stays off.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: enables POST /api/payments/webhook (set the same value in the
# Razorpay dashboard → Webhooks). Without it the webhook route returns 503.
RAZORPAY_WEBHOOK_SECRET=
