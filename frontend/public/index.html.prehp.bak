    <!-- The cart/wishlist slide-over panels, their backdrop and the toast stack
         are created at runtime by initPanels() in common.js, which is also the
         single owner of cart state. The static #cartSidebar / #wishSidebar /
         #overlay / #toastStack markup that used to sit here belonged to the
         removed second cart implementation. -->

    <!-- Swiper.js JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>


    <!-- External JavaScript -->
    <script src="/frontend/js/script.js"></script>
    <script src="/frontend/js/home.js" defer></script>

    <!-- Shared cart / wishlist (same storage as product pages) -->
    <script src="/frontend/js/api.js"></script>
    <script src="/frontend/js/data.js"></script>
    <script src="/frontend/js/common.js"></script>
    <!-- Razorpay Standard Checkout (powers "Pay Online" in the cart panel) -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/frontend/js/payment.js"></script>
    <script>
      // Wire shared slide panels and sync badge counts.
      // initHeader() is NOT called here (script.js already handles sticky /
      // mobile-drawer / auth); we only need the panels + badge counts.
      (function () {
        function boot() {
          if (typeof initPanels === 'function') initPanels();
          if (typeof store !== 'undefined' && store.syncCounts) store.syncCounts();
          // Keep badges in sync when the user adds items on another tab
          if (!window.__ffStorageSync) {
            window.__ffStorageSync = true;
            window.addEventListener('storage', function (e) {
              if (e.key !== 'ff_cart' && e.key !== 'ff_wish' && e.key !== null) return;
              if (typeof store !== 'undefined') {
                store.syncCounts();
                store._refreshCartPanel();
                store._refreshWishPanel();
              }
            });
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot);
        } else {
          boot();
        }
      })();
    </script>
</body>

