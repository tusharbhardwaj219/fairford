    <main id="main">

    <!-- ================================================================
         HERO SLIDER — one panel, three slides
         The panel is a single contained card: rounded, elevated, with the
         artwork filling it edge to edge and a caption bar carrying each
         slide's title and CTA. Panel shape is 3:2 because two of the three
         banners are 3:2 and fill it exactly; the 16:9 UPHAAR banner keeps
         its own edge-matched gradient behind it so its thin top/bottom
         margin is invisible rather than a grey band.
         ================================================================ -->
    <section class="fh-hero" id="fhHero" aria-roledescription="carousel"
             aria-label="Fair Ford highlights">
        <div class="fh-hero__panel">

            <div class="fh-hero__stage">

                <!-- SLIDE 1 — Fair Ford Pharmaceuticals -->
                <figure class="fh-slide fh-slide--ff is-active"
                        role="group" aria-roledescription="slide" aria-label="1 of 3: Fair Ford Pharmaceuticals">
                    <img class="fh-slide__art" width="1536" height="1024" fetchpriority="high" decoding="async"
                         src="https://res.cloudinary.com/dp4yririh/image/upload/v1787375353/ChatGPT_Image_Aug_22_2026_10_38_47_AM_xbwsfh.png"
                         alt="Fair Ford Pharmaceuticals — Trusted Care. Better Living. WHO-GMP certified medicines.">
                </figure>

                <!-- SLIDE 2 — UPHAAR -->
                <figure class="fh-slide fh-slide--uphaar"
                        role="group" aria-roledescription="slide"
                        aria-label="2 of 3: UPHAAR, the chemist's growth program" aria-hidden="true">
                    <img class="fh-slide__art" width="1672" height="941" fetchpriority="low" decoding="async"
                         src="https://res.cloudinary.com/dp4yririh/image/upload/v1787375632/ChatGPT_Image_Aug_22_2026_10_43_12_AM_hgfxfz.png"
                         alt="UPHAAR — thoughtfully crafted for better living. Premium rewards for chemists.">
                </figure>

                <!-- SLIDE 3 — NUEVA VIDA -->
                <figure class="fh-slide fh-slide--nueva"
                        role="group" aria-roledescription="slide"
                        aria-label="3 of 3: NUEVA VIDA nutraceuticals" aria-hidden="true">
                    <img class="fh-slide__art" width="1626" height="967" fetchpriority="low" decoding="async"
                         src="https://res.cloudinary.com/dp4yririh/image/upload/v1787383407/ChatGPT_Image_Aug_22_2026_12_53_05_PM_ixpljr.png"
                         alt="NUEVA VIDA WOMEN — Feel Strong. Live Vibrantly. Daily wellness support for women.">
                </figure>
            </div>

