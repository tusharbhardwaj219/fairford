  <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in — Fair Ford Pharmaceuticals B2B Portal</title>
  <meta name="description" content="Sign in to the Fair Ford Pharmaceuticals B2B portal to browse the catalogue, view your trade pricing and place orders." />
<link rel="preconnect" href="https://api.fontshare.com">
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
    <link href="https://api.fontshare.com/v2/css?f%5B%5D=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f%5B%5D=satoshi@400,500,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/frontend/css/typography.css">
  <link rel="stylesheet" href="/frontend/css/login&signup.css" />
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dp4yririh/image/upload/v1782967649/fairford/site/m5d8pmtzdjr4dcgctvuc.png">

  <!-- Syne was requested here but its only reference in login&signup.css is a
       commented-out rule, so the family downloaded and was never used. The page
       renders in Inter (body) and DM Sans. -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
  <!-- Page loader (see css/loader.css + js/loader.js). Not deferred:
       the overlay must exist before first paint. -->
  <link rel="stylesheet" href="/frontend/css/loader.css" />
  <script src="/frontend/js/loader.js"></script>
</head>

<body><!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5B2HT6FW"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <div class="page-wrap">

    <!-- ────── LEFT PANEL ────── -->
    <div class="left-panel">

      <!-- India map (behind content) -->
      <div class="india-map-wrap">
        <img src="https://res.cloudinary.com/dp4yririh/image/upload/v1782967653/fairford/site/a8mcgoyzg3smb8lcjxxi.png" alt="India Network Map" class="india-map-img" width="520" height="520" loading="lazy" decoding="async" />
      </div>

      <div class="brand">
        <div class="brand-logo"><a href="index.html"><img src=https://res.cloudinary.com/dp4yririh/image/upload/v1782967649/fairford/site/m5d8pmtzdjr4dcgctvuc.png alt="fair ford logo" width="50px"  height="50px"></a></div>
        <div class="brand-text">
          <span class="brand-name">Fair Ford Platform</span>
          <span class="brand-sub">Pharma · EST. 2013</span>
        </div>
      </div>

      <div class="hero-content">
        <!-- Was "India's #1 Pharma Commerce Ecosystem" — an unsubstantiated
             superlative ranking claim with no source. -->
        <div class="hero-badge">
          <div class="badge-dot"></div>
          Pharma commerce for distributors, chemists &amp; institutions
        </div>

        <h1 class="hero-headline">
          One Platform.<br />
          <span class="grad">Every Healthcare</span><br />
          Segment Connected.
        </h1>
        <div class="headline-bar"></div>
        
        <!-- "real-time inventory, smart settlement & AI-powered analytics"
             described none of the shipped features. Replaced with what the
             platform actually does. -->
        <p class="hero-desc">
          Fair Ford connects distributors, stockists, retail chemists, hospitals and institutions
          across India — online ordering, automatic routing to your nearest stockist, and
          cash-on-delivery or online payment.
        </p>

        <div class="stat-row">
          <div class="stat-item">
            <i class="ri-group-line stat-icon"></i>
            <div class="stat-val">700+</div>
            <div class="stat-label">Distributors</div>
          </div>
          <div class="stat-item">
            <i class="ri-store-line stat-icon"></i>
            <div class="stat-val">100K+</div>
            <div class="stat-label">Retailers</div>
          </div>
          <div class="stat-item">
            <i class="ri-hospital-line stat-icon"></i>
            <div class="stat-val">240+</div>
            <div class="stat-label">Hospitals</div>
          </div>
          <!-- A "1.2M+ Patients" stat sat here. It appears nowhere else on the
               site and has no source; the other three match the figures used
               elsewhere and are pending business confirmation. -->

        </div>
      </div>

      <div class="left-footer">
        <span>© 2026 Fair Ford Pharma</span>
        <span class="sep">·</span>
        <a href="privacy&amp;policy.html">Privacy Policy</a>
        <span class="sep">·</span>
        <a href="T&amp;C.html">Terms of Use</a>
        <!-- "CDSCO Compliant" was a third href="#" here. It read as a link but
             went nowhere, and it is a regulatory claim rather than a
             destination, so it is stated as text on the trust row instead. -->
      </div>
    </div>

    <!-- ────── RIGHT PANEL ────── -->
    <div class="right-panel">
      <div class="form-container">

        <div class="form-header">
          <div id="contextTag" class="context-tag tag-ret"><i class="ri-price-tag-3-line"></i> RETAILER / CHEMIST
          </div>
          <h2 class="form-title">Welcome back</h2>
          <p class="form-subtitle">Sign in to browse products and place orders.</p>
        </div>

        <!-- FORM -->
        <form id="authForm" onsubmit="handleLogin(event)">
          <!-- Auth status message -->
          <div id="authMessage" class="auth-msg" style="display:none;"></div>

          <div class="field-group">
            <label class="field-label" for="email">Email Address</label>
            <div class="field-wrap">
              <svg class="field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <input type="email" id="email" placeholder="you@company.com" autocomplete="email" required />
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="password">Password</label>
            <div class="field-wrap">
              <svg class="field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <input type="password" id="password" placeholder="••••••••••" autocomplete="current-password" required />
              <button type="button" class="pw-toggle" onclick="togglePw()" data-visible="false" aria-label="Show password">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="row-2">
            <label class="remember">
              <input type="checkbox" id="rememberMe" /> Keep me signed in
            </label>
            <a href="forgot-password.html" class="forgot">Forgot password?</a>
          </div>

          <!-- authController.login resolves the account across the Retailer,
               Distributor and Admin collections and redirects by its real role,
               so this one form serves every account type. Labelling it
               "Sign in as Retailer" told admins and distributors they were in
               the wrong place. -->
          <button type="submit" class="btn-signin" id="signinBtn">
            Sign in →
          </button>
        </form>

        <div class="register-row">
          New to Fair Ford? <a href="registration.html">Create Account →</a>
        </div>

        <div class="trust-row">
          <div class="trust-item"><i class="ri-lock-2-line"></i> SSL Encrypted</div>
          <div class="trust-item"><i class="ri-shield-check-line"></i> CDSCO Compliant</div>
          <div class="trust-item"><i class="ri-verified-badge-line"></i> GST Verified</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Live badge -->
  <div class="floaty">
    <div class="floaty-dot"></div>
    <div class="floaty-text"><strong>&nbsp; &nbsp;2,481</strong> orders processed today &nbsp;·&nbsp; ₹48.2L GMV</div>
  </div>

  <script src="/frontend/js/login&signup.js"></script>
</body>

</html>